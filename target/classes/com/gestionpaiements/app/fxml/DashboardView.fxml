<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gestionpaiements.app.controller.DashboardController"
      spacing="20" styleClass="dashboard-root">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <Label text="Tableau de bord" styleClass="page-title"/>

    <HBox spacing="20">
        <VBox styleClass="stat-card, stat-card-green" HBox.hgrow="ALWAYS">
            <Label text="VACATAIRE" styleClass="stat-label-green"/>
            <Label fx:id="countVacataire" text="0" styleClass="stat-number-green"/>
            <Label text="Enregistrements" styleClass="stat-sub"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-blue" HBox.hgrow="ALWAYS">
            <Label text="HEURE SUP" styleClass="stat-label-blue"/>
            <Label fx:id="countHeureSup" text="0" styleClass="stat-number-blue"/>
            <Label text="Enregistrements" styleClass="stat-sub"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-orange" HBox.hgrow="ALWAYS">
            <Label text="DÉPLACEMENT" styleClass="stat-label-orange"/>
            <Label fx:id="countDeplacement" text="0" styleClass="stat-number-orange"/>
            <Label text="Enregistrements" styleClass="stat-sub"/>
        </VBox>
        <VBox styleClass="stat-card, stat-card-purple" HBox.hgrow="ALWAYS">
            <Label text="TOTAL" styleClass="stat-label-purple"/>
            <Label fx:id="countTotal" text="0" styleClass="stat-number-purple"/>
            <Label text="Enregistrements" styleClass="stat-sub"/>
        </VBox>
    </HBox>

    <Label text="Derniers enregistrements" styleClass="section-title"/>

    <TableView fx:id="recentsTable" styleClass="recents-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDate" text="DATE" prefWidth="120"/>
            <TableColumn fx:id="colNom" text="NOM COMPLET" prefWidth="220"/>
            <TableColumn fx:id="colType" text="TYPE" prefWidth="150"/>
            <TableColumn fx:id="colMontant" text="MONTANT NET" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>