<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestionpaiements.app.controller.MainViewController"
            stylesheets="@dashboard.css"
            styleClass="root-pane">
    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="20">
            <Label text="Gestion des Paiements" styleClass="sidebar-title" wrapText="true">
                <padding><Insets top="25" right="15" bottom="25" left="20"/></padding>
            </Label>
            <Button fx:id="navDashboard" text="🏠  Tableau de bord" onAction="#showDashboard" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="navAjouter" text="➕  Ajouter un paiement" onAction="#showAjouterPaiement" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="navVacataire" text="👤  Vacataire" onAction="#showVacataire" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="navHeureSup" text="🕒  Heure Supplementaire" onAction="#showHeureSup" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="navDeplacement" text="🚗  Déplacement" onAction="#showDeplacement" styleClass="nav-button" maxWidth="Infinity"/>
            

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="⎋  Déconnexion" onAction="#handleLogout" styleClass="nav-button, nav-button-logout" maxWidth="Infinity">
                <VBox.margin><Insets bottom="20"/></VBox.margin>
            </Button>
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <HBox styleClass="topbar" alignment="CENTER_RIGHT" spacing="10">
                    <padding><Insets top="12" right="25" bottom="12" left="25"/></padding>
                    <Label fx:id="userLabel" text="👤 Admin" styleClass="user-label"/>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contentArea" styleClass="content-area"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>